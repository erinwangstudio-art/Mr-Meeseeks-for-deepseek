{
  "name": "dsh-logo-swap",
  "description": "DeepSeek Harness 品牌自定义插件：替换侧栏 Logo、品牌字标、对话页 Logo、欢迎语标语；预览版徽章支持官方/隐藏/自定义文字三模式。出厂预设可通过源码常量或设置面板修改。纯前端注入，不修改任何安装文件，DSH 升级不受影响。",
  "version": "1.0.0",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "icon.png",
    "lib/index.js",
    "lib/client.js",
    "lib/wm-paths.json",
    "cordis.patch.yml",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=18"
  }
}
